{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "PL" }],
      "destination": "/pl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "pl.*" }],
      "destination": "/pl/",
      "permanent": false
    },
    { "source": "/", "destination": "/en/", "permanent": false },
    { "source": "/about/", "destination": "/en/about/", "permanent": true },
    { "source": "/blog/", "destination": "/en/blog/", "permanent": true },
    { "source": "/extensor-tendon-injuries/", "destination": "/en/blog/extensor-tendon-injuries/", "permanent": true },
    { "source": "/scaphoid-fractures/", "destination": "/en/blog/scaphoid-fractures/", "permanent": true },
    { "source": "/flexor-tendon-injuries-and-repair/", "destination": "/en/blog/flexor-tendon-injuries-and-repair/", "permanent": true },
    { "source": "/carpal-tunnel-syndrome-doctors-explanation/", "destination": "/en/blog/carpal-tunnel-syndrome/", "permanent": true },
    { "source": "/homepage/contact/", "destination": "/en/contact/", "permanent": true },
    { "source": "/zespol-ciesni-nadgarstka/", "destination": "/pl/blog/zespol-ciesni-nadgarstka/", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "/en/", "permanent": true },
    { "source": "/feed/", "destination": "/en/blog/", "permanent": true },
    { "source": "/en/learn/", "destination": "https://learn.drgladysz.com/", "permanent": true },
    { "source": "/pl/nauka/", "destination": "https://learn.drgladysz.com/", "permanent": true },
    { "source": "/en/glossary/wyniki-raportowane-przez-pacjenta/", "destination": "/en/glossary/patient-reported-outcome-measures/", "permanent": true },
    { "source": "/pl/slowniczek/wyniki-raportowane-przez-pacjenta/", "destination": "/pl/slowniczek/patient-reported-outcome-measures/", "permanent": true },
    { "source": "/en/glossary/guzek-dd/", "destination": "/en/glossary/dupuytrens-nodule/", "permanent": true },
    { "source": "/pl/slowniczek/guzek-dd/", "destination": "/pl/slowniczek/dupuytrens-nodule/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
