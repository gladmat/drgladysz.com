---
// src/components/Breadcrumb.astro
//
// Visible breadcrumb trail. Renders alongside (not in place of) the JSON-LD
// BreadcrumbList that's already emitted by generateBreadcrumb() in schema.ts.
//
// Mobile-friendly: wraps cleanly at narrow viewports; last item is the page
// title (non-linked, `aria-current="page"`); intermediate items are links;
// separator is `aria-hidden` so screen readers don't read "slash slash slash".
//
// Slotted into:
//   - /en/blog/[slug].astro            (article)
//   - /pl/blog/[slug].astro            (article)
//   - /en/procedures/[slug].astro      (procedure)
//   - /pl/zabiegi/[slug].astro         (procedure)
//
// The category landing pages it links to are at /en/blog/category/[c]/ and
// /pl/blog/kategoria/[c]/ for articles, and the existing /en/procedures/#[c]
// anchors for procedures (procedure index has anchored category sections).
interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  items: BreadcrumbItem[];
  ariaLabel?: string;
}

const { items, ariaLabel = 'Breadcrumb' } = Astro.props;
---

<nav aria-label={ariaLabel} class="breadcrumb">
  <ol>
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li>
          {!isLast && item.url ? (
            <a href={item.url}>{item.name}</a>
          ) : (
            <span aria-current={isLast ? 'page' : undefined}>{item.name}</span>
          )}
          {!isLast && <span aria-hidden="true" class="separator">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 24px;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .breadcrumb a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .breadcrumb [aria-current='page'] {
    color: var(--ink);
    /* Last item often the long article title — let it truncate on narrow
       viewports rather than push the breadcrumb into a third row. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60ch;
  }
  .separator {
    color: var(--ink-3);
  }

  @media (max-width: 480px) {
    .breadcrumb [aria-current='page'] {
      max-width: 28ch;
    }
  }
</style>
