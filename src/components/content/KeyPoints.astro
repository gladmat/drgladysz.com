---
// src/components/content/KeyPoints.astro
//
// JAMA-style 75-100 word summary box at the top of an article or procedure
// page. Three-line structure: Question, Findings (or Indications), Meaning.
// Each line label is a mono cap rule; the body sits in the serif voice so
// the box reads as a clinical summary, not a UI panel.
//
// Render-policy: only emits the section if at least one of the three fields
// is populated. A box with all three empty is suppressed entirely.
interface Props {
  question?: string;
  findings?: string;
  meaning?: string;
  /**
   * Locale drives default label translations. Explicit `findingsLabel` /
   * `meaningLabel` props override the locale default (procedure pages do this
   * to swap "Findings" → "Indications" / "Wskazania i przebieg").
   */
  locale?: 'en' | 'pl';
  /**
   * Whether the third line is "Meaning" (typical article) or "Clinical relevance"
   * (procedure pages). Defaults derive from locale.
   */
  meaningLabel?: string;
  /**
   * Whether the second line is "Findings" (typical article) or "Indications"
   * (procedure pages). Defaults derive from locale.
   */
  findingsLabel?: string;
}

const {
  question,
  findings,
  meaning,
  locale = 'en',
  meaningLabel,
  findingsLabel,
} = Astro.props;

const labels = locale === 'pl'
  ? {
      heading: 'Kluczowe punkty',
      ariaLabel: 'Kluczowe punkty',
      question: 'Pytanie',
      findings: 'Ustalenia',
      meaning: 'Znaczenie',
    }
  : {
      heading: 'Key Points',
      ariaLabel: 'Key points',
      question: 'Question',
      findings: 'Findings',
      meaning: 'Meaning',
    };

const resolvedFindingsLabel = findingsLabel ?? labels.findings;
const resolvedMeaningLabel = meaningLabel ?? labels.meaning;

const hasContent = Boolean(question || findings || meaning);
---
{hasContent && (
  <aside class="keypoints" aria-label={labels.ariaLabel}>
    <h2 class="keypoints-heading">{labels.heading}</h2>
    <dl class="keypoints-list">
      {question && (
        <div class="kp-row">
          <dt>{labels.question}</dt>
          <dd>{question}</dd>
        </div>
      )}
      {findings && (
        <div class="kp-row">
          <dt>{resolvedFindingsLabel}</dt>
          <dd>{findings}</dd>
        </div>
      )}
      {meaning && (
        <div class="kp-row">
          <dt>{resolvedMeaningLabel}</dt>
          <dd>{meaning}</dd>
        </div>
      )}
    </dl>
  </aside>
)}

<style>
  .keypoints {
    margin: 48px 0;
    padding: 28px 32px;
    background: var(--bg-deep);
    border-left: 3px solid var(--accent);
  }

  .keypoints-heading {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
    font-weight: 500;
  }

  .keypoints-list {
    margin: 0;
    display: grid;
    gap: 16px;
  }

  .kp-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    align-items: baseline;
  }

  @media (max-width: 600px) {
    .kp-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .kp-row dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    /* Was var(--ink-3) → 4.13:1 contrast on bg-deep, fails WCAG AA.
       Stepped down to a darker grey that hits ≥5:1 on the cream
       background while keeping the muted "metadata label" register. */
    color: #555a5d;
    margin: 0;
    padding-top: 4px;
  }

  .kp-row dd {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
  }
</style>
