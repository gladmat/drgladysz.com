---
// src/pages/en/blog/category/[category].astro
//
// Category landing page — lists articles in a single category. Mirrors the
// /en/blog/ index card style but filtered to one editorial bucket.
//
// Topic-hub pages are valuable for two reasons:
//   1. Internal PageRank flow — every article in the category links here via
//      the breadcrumb trail, distributing link equity to the topic root.
//   2. Long-tail SEO — broader queries like "patient information hand surgery"
//      have a dedicated landing page rather than redirecting to the global
//      index where the relevant articles are buried below FESSH-prep entries.
//
// Categories are statically declared (4 values) so getStaticPaths returns
// a finite set; empty categories still build a landing page that gracefully
// says "no articles yet" — that's preferable to a 404 for the breadcrumb.
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionMasthead from '@/components/SectionMasthead.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getAllArticleSummaries, type ArticleSummary } from '@/lib/sanity';
import { generateBreadcrumb } from '@/lib/schema';

type Category = ArticleSummary['category'];

const CATEGORY_META: Record<Category, {
  label: string;
  description: string;
  blurb: string;
  plSlug: string;
}> = {
  patient: {
    label: 'Patient information',
    description:
      'Plain-language guides to common conditions, what diagnosis involves, and what to expect from treatment.',
    blurb:
      'Patient-facing guides to common hand and upper-extremity conditions — what they are, how they’re diagnosed, when surgery is indicated, and what recovery looks like.',
    plSlug: 'pacjent',
  },
  expert: {
    label: 'Expert blog',
    description:
      'Surgical technique, evidence reviews, and operative decision-making written for clinical peers.',
    blurb:
      'Surgical technique, evidence reviews, and operative decision-making written for clinical peers in hand, microsurgical, and skin-cancer surgery.',
    plSlug: 'ekspert',
  },
  'fessh-prep': {
    label: 'FESSH preparation',
    description:
      'Reading notes and structured summaries for the FESSH Diploma examination in hand surgery.',
    blurb:
      'Structured reading and reference notes for the FESSH (Federation of European Societies for Surgery of the Hand) Diploma examination.',
    plSlug: 'fessh-prep',
  },
  news: {
    label: 'News & commentary',
    description:
      'Notes on conferences, meetings, and current developments in the field.',
    blurb:
      'Notes on conferences, meetings, and current developments in hand, microsurgical, and skin-cancer surgery.',
    plSlug: 'aktualnosci',
  },
};

export async function getStaticPaths() {
  const categories: Category[] = ['patient', 'expert', 'fessh-prep', 'news'];
  return categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: Category };
const meta = CATEGORY_META[category];
if (!meta) return Astro.redirect('/en/blog/');

const articles = await getAllArticleSummaries('en');
const items = articles
  .filter((a) => a.category === category)
  .sort((a, b) =>
    new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime(),
  );

const siteUrl = (
  import.meta.env.PUBLIC_SITE_URL || 'https://drgladysz.com'
).replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/en/blog/category/${category}/`;
const alternateUrl = `/pl/blog/kategoria/${meta.plSlug}/`;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonicalUrl,
  name: `${meta.label} — Mateusz Gładysz, MD`,
  description: meta.description,
  url: canonicalUrl,
  inLanguage: 'en-NZ',
  isPartOf: { '@id': `${siteUrl}/#website` },
  hasPart: items.map((a) => ({
    '@type': 'Article',
    headline: a.title,
    url: `${siteUrl}/en/blog/${a.slug.current}/`,
    datePublished: a.publishedDate,
    description: a.excerpt,
  })),
};

const breadcrumbJsonLd = generateBreadcrumb([
  { name: 'Home', url: `${siteUrl}/en/` },
  { name: 'Knowledge base', url: `${siteUrl}/en/blog/` },
  { name: meta.label, url: canonicalUrl },
]);

function fmtDate(d?: string) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-NZ', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<SiteLayout
  title={`${meta.label} — Mateusz Gładysz, MD`}
  description={meta.description}
  locale="en"
  alternateUrl={alternateUrl}
  canonical={canonicalUrl}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <section class="index-masthead-shell">
    <Breadcrumb items={[
      { name: 'Home', url: '/en/' },
      { name: 'Knowledge base', url: '/en/blog/' },
      { name: meta.label },
    ]} />
    <SectionMasthead
      label="Knowledge base"
      heading={meta.label}
      headingTag="h1"
      standfirst={meta.blurb}
    />
  </section>

  <section class="blog-index">
    <div class="blog-index-inner">
      {items.length === 0 ? (
        <div class="empty">
          <p>No articles in this category yet. Check back shortly, or browse the <a href="/en/blog/">full knowledge base</a>.</p>
        </div>
      ) : (
        <ol class="article-list">
          {items.map((article) => (
            <li class="article-card">
              <a href={`/en/blog/${article.slug.current}/`} class="article-card-link">
                <p class="card-meta">
                  <time datetime={article.publishedDate}>{fmtDate(article.publishedDate)}</time>
                  {article.lastUpdated && article.lastUpdated !== article.publishedDate && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="card-updated">Updated {fmtDate(article.lastUpdated)}</span>
                    </>
                  )}
                </p>
                <h2 class="card-title">{article.title}</h2>
                <p class="card-excerpt">{article.excerpt}</p>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</SiteLayout>

<style>
  .index-masthead-shell {
    padding: clamp(56px, 8vw, 120px) clamp(20px, 5vw, 80px) 0;
    max-width: 1320px;
    margin: 0 auto;
  }

  .blog-index {
    padding: clamp(40px, 6vw, 80px) 0 120px;
  }

  .blog-index-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 80px);
  }

  .empty {
    max-width: 60ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-2);
  }

  .empty a {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    text-decoration: none;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .article-card {
    border-top: 1px solid var(--rule);
    padding: 32px 0;
  }

  .article-card:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .article-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .article-card-link:hover .card-title {
    color: var(--accent);
  }

  .card-meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 12px;
  }

  .card-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 12px;
    transition: color 0.15s ease;
  }

  .card-excerpt {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 65ch;
    margin: 0;
  }
</style>
